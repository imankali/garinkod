# GarinKood backend environment
# Copy to .env for local development. Never commit real secrets.

# -----------------------------------------------------------------------------
# Core local development
# -----------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=replace-with-a-long-random-development-secret
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
SQLITE_TIMEOUT=30
CACHE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
SITE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ADMIN_PUBLIC_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Production baseline (examples only; use a secret manager):
# DEBUG=False
# SECRET_KEY=generate-at-least-50-random-characters
# DB_ENGINE=postgresql
# DB_NAME=garinkood
# DB_USER=garinkood
# DB_PASSWORD=replace-me
# DB_HOST=postgres
# DB_PORT=5432
# DB_CONN_MAX_AGE=60
# CACHE_URL=redis://redis:6379/1
# ALLOWED_HOSTS=garinkood.ir,www.garinkood.ir
# SITE_URL=https://garinkood.ir
# FRONTEND_URL=https://garinkood.ir
# ADMIN_PUBLIC_URL=https://garinkood.ir
# CORS_ALLOWED_ORIGINS=https://garinkood.ir,https://www.garinkood.ir
# CSRF_TRUSTED_ORIGINS=https://garinkood.ir,https://www.garinkood.ir
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# AUTH_COOKIE_AGE=1209600

# -----------------------------------------------------------------------------
# Abuse prevention and API budgets
# Shared Redis is required for consistent multi-worker limits in production.
# -----------------------------------------------------------------------------
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30
AXES_VERBOSE=False
THROTTLE_ANON=120/hour
THROTTLE_USER=600/hour
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/hour
THROTTLE_OTP_REQUEST=30/hour
THROTTLE_OTP_VERIFY=60/hour
THROTTLE_SEARCH=60/min
# سقف خواندن صف پیام‌ها — جدا از THROTTLE_USER، وگرنه /messages بعد از یک دقیقه ۴۲۹ می‌گیرد
THROTTLE_INBOX=60/min
THROTTLE_CHECKOUT=12/hour
THROTTLE_UPLOAD=20/hour
THROTTLE_FEEDBACK=10/hour

# -----------------------------------------------------------------------------
# Payment
# Zarinpal is implemented but disabled until merchant credentials and a real
# HTTPS callback are verified in sandbox/provider-side tests. Amounts use IRT.
# The other provider switches remain disabled placeholders, not live adapters.
# -----------------------------------------------------------------------------
PAYMENT_HTTP_TIMEOUT=10
PAYMENT_CALLBACK_BASE_URL=http://localhost:5173
PAYMENT_ENABLE_ZARINPAL=False
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=True
PAYMENT_ENABLE_STRIPE=False
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
PAYMENT_ENABLE_PAYPAL=False
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYMENT_ENABLE_CRYPTO=False
CRYPTO_PAYMENT_PROVIDER_KEY=

# -----------------------------------------------------------------------------
# Shipping — deterministic manual fulfilment remains the honest default.
# Values are تومان. No carrier is claimed active without a verified contract.
# -----------------------------------------------------------------------------
SHIPPING_FLAT_RATE=45000
SHIPPING_FREE_THRESHOLD=2000000

# -----------------------------------------------------------------------------
# Messaging Hub — all channels are opt-in. Run the durable worker separately:
# python manage.py process_notifications --watch
# -----------------------------------------------------------------------------
MESSAGING_HTTP_TIMEOUT=8
MESSAGING_FAKE=False
MESSAGING_ENABLE_SMS=False
MESSAGING_ENABLE_BALE=False
MESSAGING_ENABLE_TELEGRAM=False
MESSAGING_ENABLE_WHATSAPP=False
NOTIFICATION_MAX_ATTEMPTS=6
NOTIFICATION_WORKER_STALE_SECONDS=600
NOTIFICATION_ADMIN_TELEGRAM_CHAT_IDS=
NOTIFICATION_ADMIN_BALE_CHAT_IDS=
NOTIFICATION_ADMIN_SMS_NUMBERS=
NOTIFICATION_ADMIN_WHATSAPP_NUMBERS=
# Optional customer order-status channels: sms,bale,whatsapp
NOTIFICATION_CUSTOMER_STATUS_CHANNELS=

# Passwordless mobile OTP. Debug codes are forbidden outside isolated local use.
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=180
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_PHONE_RATE_LIMIT=8
OTP_PHONE_RATE_WINDOW_SECONDS=3600
OTP_DELIVERY_CHANNELS=sms,bale
OTP_RETURN_DEBUG_CODE=False

# SMS.ir (SMS_PROVIDER=smsir); the Verify parameter usually is Code.
SMS_PROVIDER=smsir
SMSIR_API_KEY=
SMSIR_OTP_TEMPLATE_ID=0
SMSIR_OTP_PARAMETER=Code
SMSIR_LINE_NUMBER=0

# Kavenegar alternative (SMS_PROVIDER=kavenegar).
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=
KAVENEGAR_SENDER=

# Bale official Safir for OTP and Bot API for administrative alerts.
BALE_SAFIR_API_KEY=
BALE_SAFIR_BOT_ID=0
BALE_BOT_TOKEN=

# Telegram official Bot API.
TELEGRAM_BOT_TOKEN=

# Meta official WhatsApp Cloud API; approved templates are configured in admin.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_ALLOW_FREEFORM=False

# -----------------------------------------------------------------------------
# Browser Push — uses VAPID and the existing durable notification outbox.
# Generate a dedicated keypair and keep the private key in secret storage.
# -----------------------------------------------------------------------------
WEBPUSH_ENABLED=False
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:ops@example.invalid

# -----------------------------------------------------------------------------
# Optional external search. ORM search remains the automatic fallback.
# Activate the Django Waffle flag `external_product_search` after sync/validation.
# -----------------------------------------------------------------------------
MEILISEARCH_ENABLED=False
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=
MEILISEARCH_PRODUCTS_INDEX=products
MEILISEARCH_TIMEOUT_SECONDS=1.5

# -----------------------------------------------------------------------------
# Media storage. `local` is default. For S3-compatible storage, set backend to
# s3 and verify upload/read/delete, CORS, lifecycle, backups, and IAM policy.
# Credentials may be blank when the runtime supplies a secure IAM role.
# -----------------------------------------------------------------------------
MEDIA_STORAGE_BACKEND=local
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_REGION_NAME=
S3_CUSTOM_DOMAIN=
S3_QUERYSTRING_AUTH=True

# Upload limits and allowlists.
VISUAL_SEARCH_MAX_UPLOAD_BYTES=5242880
AVATAR_MAX_UPLOAD_BYTES=2097152
AVATAR_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp
MESSAGE_IMAGE_MAX_BYTES=5242880
MESSAGE_AUDIO_MAX_BYTES=10485760
MESSAGE_VIDEO_MAX_BYTES=26214400
MESSAGE_IMAGE_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/gif
MESSAGE_AUDIO_CONTENT_TYPES=audio/webm,audio/ogg,audio/mpeg,audio/mp4,audio/aac,audio/wav
MESSAGE_VIDEO_CONTENT_TYPES=video/mp4,video/webm,video/quicktime

# -----------------------------------------------------------------------------
# Operations and observability
# /health/live is public. /health/ready and /metrics require a staff session or
# this high-entropy bearer token. Sentry is inert without a DSN and sends no PII.
# -----------------------------------------------------------------------------
OPERATIONS_TOKEN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# A preview opened inside an iframe of another host is a third-party context, and a
# SameSite=Lax session cookie is never sent from one: logins look like failures while
# nothing is wrong. Set this locally so the auth, session and CSRF cookies become
# SameSite=None; Secure (the preview must be HTTPS). Leave it unset in production —
# manage.py check reports shop.W110 if it is set outside DEBUG. With the switch on and
# DEBUG set, the auth responses also carry preview_token so the SPA can sign in through
# an Authorization header (or ?gk_token=…, when the proxy in front of the frame drops
# headers) when even that cookie is refused; both fields are absent otherwise.
# Django's own /admin/ still needs a cookie, so open it in its own tab.
GK_PREVIEW_IFRAME_COOKIES=False

# SMTP is presently available for Django/system mail; leave local defaults when
# no monitored transactional email provider has been configured.
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=noreply@example.invalid
