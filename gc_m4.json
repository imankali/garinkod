 از پشتیبانی کشاورزان:\nپاسخ این مورد از حیطه مشاوره خارج است؛ از لینک پایین آن را با پشتیبانی ادامه دهید تا سریع‌تر نتیجه شود.\n— آخرین پیام‌های آن گفتگو —\nمیز: سلام! پرونده را دیدم؛ با توجه به خاک آهکی و آبیاری قطره‌ای، احتمال کمبود آهن زیاد است. لطفا یک عکس از برگ‌ها هم بفرستید تا مطمئن شوم.\nکشاورز: عکس را فرستادم. اگر کمبود آهن باشد چه محصولی پیشنهاد می‌کنید؟\nمیز: لطفا یک عکس واضح از برگ (از نزدیک) و یک عکس از کل بوته بفرستید.\nمیز: برای دوز دقیق، پرونده زمین (نوع خاک، آبیاری و تقویم کشت) را در همین گفتگو بفرستید.","listing":null,"land":null,"post":null,"link":null,"attachment":null,"attachment_url":"","attachment_type":"","attachment_duration":null,"reply_to":null,"is_edited":false,"edited_at":null,"is_deleted":false,"deleted_at":null,"can_edit":true,"can_delete":true,"is_read":true,"created_at":"2026-09-10T06:25:40.279067+03:30"},{"id":22,"conversation":4,"sender":null,"sender_name":"گرین کود","sender_avatar_url":"","sender_role_label":"اعلان سیستم","sender_verified":false,"is_mine":false,"is_system":true,"body":"کاربر گفتگو را پایان داد و نظرسنجی برایش باز شد.","listing":null,"land":null,"post":null,"link":null,"attachment":null,"attachment_url":"","attachment_type":"","attachment_duration":null,"reply_to":null,"is_edited":false,"edited_at":null,"is_deleted":false,"deleted_at":null,"can_edit":false,"can_delete":false,"is_read":true,"created_at":"2026-09-10T06:29:56.012654+03:30"}],"conversation":{"id":4,"channel":"support","channel_label":"پشتیبانی","subject":"لغو سفارش","storefront":null,"counterpart_name":"کشاورز تستی","counterpart_avatar_url":"","last_message":{"id":10,"conversation":4,"sender":8,"sender_name":"کشاورز تستی","sender_avatar_url":"","sender_role_label":"","sender_verified":false,"is_mine":false,"is_system":false,"body":"سلام، می‌خواهم سفارشم را لغو کنم چون اشتباهی دو بار ثبت شده.","listing":null,"land":null,"post":null,"link":null,"attachment":null,"attachment_url":"","attachment_type":"","attachment_duration":null,"reply_to":null,"is_edit