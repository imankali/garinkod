# GarinKood frontend build settings
# Copy to .env.local for local development. VITE_* values are public and are
# embedded in the JavaScript bundle: never put secrets or private API keys here.

# Canonical public origin used by SEO metadata (no trailing slash).
VITE_SITE_URL=http://localhost:5173

# Public support details. Leave blank until real, monitored destinations exist.
VITE_PHONE_NUMBER=
VITE_SUPPORT_EMAIL=
# WhatsApp digits only, including country code, without + or 00.
VITE_WHATSAPP_NUMBER=

# Optional frontend error reporting. Inert when the DSN is blank. Configure the
# matching backend Sentry settings separately; default PII capture stays off.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Optional consent-based aggregate analytics (Plausible-compatible manual
# script). Both values must be present AND Django Waffle flag
# `privacy_analytics` must be active. The script is never loaded before the
# visitor opts in. Self-hosted deployments may replace the HTTPS script URL.
VITE_ANALYTICS_DOMAIN=
VITE_ANALYTICS_SCRIPT_URL=https://plausible.io/js/script.manual.js
