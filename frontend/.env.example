# ========================================
# GarinKood Frontend Environment Variables
# ========================================
# این فایل را کپی کن و به `.env` تغییر نام بده:
# cp .env.example .env
# ========================================

# ========================================
# Contact Information
# ========================================
# شماره تلفن پشتیبانی (برای نمایش در سایت)
VITE_PHONE_NUMBER=02112345678

# شماره واتس‌اپ (بدون + و 00، با کد کشور)
VITE_WHATSAPP_NUMBER=989123456789

# ========================================
# API Configuration
# ========================================
# آدرس API (اگر از Vite Proxy استفاده می‌کنی، نیازی نیست)
# VITE_API_BASE_URL=http://localhost:8000/api

# ========================================
# App Settings
# ========================================
# نام سایت
VITE_APP_NAME=گرین کود

# توضیحات سایت
VITE_APP_DESCRIPTION=فروشگاه تخصصی نهاده‌های کشاورزی

# ========================================
# Feature Flags
# ========================================
# فعال/غیرفعال کردن ویژگی‌ها
VITE_ENABLE_WEATHER_WIDGET=true
VITE_ENABLE_INSTALLMENT_CALCULATOR=true
VITE_ENABLE_CROP_SELECTOR=true
VITE_ENABLE_AGRI_CALCULATOR=true

# ========================================
# Analytics (Optional)
# ========================================
# Google Analytics (اگر استفاده می‌کنی)
# VITE_GA_ID=G-XXXXXXXXXX

# ========================================
# Development Settings
# ========================================
# حالت development (فقط برای development)
VITE_DEV_MODE=true

# ========================================
# Production Settings
# ========================================
# آدرس سایت در production
# VITE_SITE_URL=https://garinkood.ir